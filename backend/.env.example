# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=vsl_crm

# Servidor
PORT=3001

# Google Calendar (OAuth2)
# GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET salen del OAuth Client (tipo "Desktop app")
# creado en Google Cloud Console. GOOGLE_REFRESH_TOKEN se obtiene una sola vez
# corriendo: pnpm get-google-token  (ver backend/scripts/get-refresh-token.mjs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendario donde se consulta disponibilidad y se crean los eventos.
# 'primary' = el calendario principal de la cuenta que autorizó el refresh token.
GOOGLE_CALENDAR_ID=primary

# Auth del CRM (/crm). Los usuarios viven en la tabla `usuarios` (login por
# email + password con bcrypt, rol admin|vendedor). ADMIN_USER/ADMIN_PASSWORD
# ya NO se leen en cada login: solo los usa backend/scripts/seed-admin.mjs
# (pnpm seed-admin) una sola vez para crear el primer usuario admin
# (email=ADMIN_USER, password=ADMIN_PASSWORD, nombre="Administrador"). Después
# de correr el seed pueden dejarse o quitarse del .env, da igual.
# JWT_SECRET debe ser una cadena aleatoria larga
# (ej: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
ADMIN_USER=
ADMIN_PASSWORD=
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma (sin espacios o con
# espacios, se recortan igual). Si se omite, cae a http://localhost:5173
# (desarrollo). En producción poner aquí el dominio real del frontend.
ALLOWED_ORIGINS=http://localhost:5173

# Webhook hacia el CRM externo (Fase 16). Si se deja vacía, POST /leads solo
# hace console.log del payload que se habría enviado — no bloquea ni rompe
# la creación del lead si el webhook falla o no está configurado.
WEBHOOK_CRM_URL=

# Notificaciones de agendamiento (Fase 14). Se disparan SOLO cuando
# POST /calendar/agendar confirma una reunión — nunca al crear el lead ni
# para descalificados. Si falta cualquiera de las 3 variables de correo, no
# se intenta enviar (solo console.log); si GOOGLE_CHAT_WEBHOOK_URL está
# vacía, ídem. Ninguna de las dos bloquea ni rompe el agendamiento si falla.
#
# Correo vía Gmail/Google Workspace + nodemailer, usando una CONTRASEÑA DE
# APLICACIÓN (no la contraseña normal de la cuenta) — se genera en
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos
# activada en esa cuenta de Google).
NOTIF_EMAIL_USER=
NOTIF_EMAIL_APP_PASSWORD=
NOTIF_EMAIL_DESTINO=

# URL del webhook entrante de un espacio de Google Chat (se crea desde el
# espacio: Apps y integraciones > Webhooks). Un solo canal para todo el
# equipo.
GOOGLE_CHAT_WEBHOOK_URL=

# Meta Conversions API (#24). Envía eventos Lead server-side a Meta cuando
# se crea un lead/contacto. Si se dejan vacías, no se envía nada (no rompe).
# META_PIXEL_ID: ID del pixel (mismo que el de los píxeles configurables).
# META_ACCESS_TOKEN: token de acceso de sistema o de largo plazo generado en
# Business Manager > Configuración del negocio > Usuarios del sistema.
META_PIXEL_ID=
META_ACCESS_TOKEN=

# URL pública del backend (para event_source_url en Meta CAPI).
# Ej: https://www.macondosoftwares.com
APP_URL=
