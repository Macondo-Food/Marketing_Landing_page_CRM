# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=vsl_crm

# Servidor
PORT=3001

# Google Calendar (OAuth2)
# GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET salen del OAuth Client (tipo "Desktop app")
# creado en Google Cloud Console. GOOGLE_REFRESH_TOKEN se obtiene una sola vez
# corriendo: pnpm get-google-token  (ver backend/scripts/get-refresh-token.mjs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendario donde se consulta disponibilidad y se crean los eventos.
# 'primary' = el calendario principal de la cuenta que autorizó el refresh token.
GOOGLE_CALENDAR_ID=primary

# Auth del CRM (/crm). Los usuarios viven en la tabla `usuarios` (login por
# email + password con bcrypt, rol admin|vendedor). ADMIN_USER/ADMIN_PASSWORD
# ya NO se leen en cada login: solo los usa backend/scripts/seed-admin.mjs
# (pnpm seed-admin) una sola vez para crear el primer usuario admin
# (email=ADMIN_USER, password=ADMIN_PASSWORD, nombre="Administrador"). Después
# de correr el seed pueden dejarse o quitarse del .env, da igual.
# JWT_SECRET debe ser una cadena aleatoria larga
# (ej: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`).
ADMIN_USER=
ADMIN_PASSWORD=
JWT_SECRET=

# Orígenes permitidos por CORS, separados por coma (sin espacios o con
# espacios, se recortan igual). Si se omite, cae a http://localhost:5173
# (desarrollo). En producción poner aquí el dominio real del frontend.
ALLOWED_ORIGINS=http://localhost:5173
