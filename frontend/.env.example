# URL base del backend. Si se omite, el frontend usa http://localhost:3099
# (ver fallback en frontend/src/services/api.js).
VITE_API_URL=http://localhost:3099

# Google Client ID para Sign-In con Google (botón en /crm login).
# Debe ser el mismo Client ID que GOOGLE_CLIENT_ID en backend/.env.
# Si se omite, el botón de Google no aparece en el login.
VITE_GOOGLE_CLIENT_ID=
